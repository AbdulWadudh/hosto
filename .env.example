DATABASE_URL="postgresql://hosto:hosto@localhost:5432/hosto?schema=public"

# Only needed when DATABASE_URL points at a connection pooler. Migrations take a
# session-scoped advisory lock, and a pooler can strand it on a backend it keeps
# alive, blocking every later deploy. Leave empty when DATABASE_URL is direct.
DIRECT_DATABASE_URL=""

BETTER_AUTH_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

S3_ENDPOINT="http://localhost:9010"
# Optional. Defaults to auto, which is what Tigris and R2 want. Real AWS
# needs its own region here.
S3_REGION=""
S3_BUCKET="hosto-assets"
S3_ACCESS_KEY_ID="hosto"
S3_SECRET_ACCESS_KEY="hostosecret"

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Notification email. Leave both empty to run without it; the app logs what it
# would have sent instead. https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM=""
